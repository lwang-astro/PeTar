se_mode=@with_interrupt@

ifneq ($(se_mode),sevn)
BSE_LIB=libbse.a
else
BSE_LIB=
endif

ifeq ($(se_mode),bse)
BSE_TEST=petar.bse
BSE_PATH=bse
CXXFLAGS = -D BSEBBF -D BSE_BASE
else ifeq ($(se_mode),mobse)
BSE_TEST=petar.mobse
BSE_PATH=mobse
CXXFLAGS = -D MOBSE -D BSE_BASE
else ifeq ($(se_mode),sevn)
BSE_TEST=petar.sevn
BSE_PATH=sevn/include/sevn
CXXFLAGS = -D SEVN -D BSE_BASE
else ifeq ($(se_mode),bseEmp)
BSE_TEST=petar.bseEmp
BSE_PATH=bseEmp
CXXFLAGS = -D BSEEMP -D BSE_BASE
endif

ifeq ($(se_mode),sevn)
BSELIBS = -I./sevn/include/sevn -L./sevn/lib/sevn -L./sevn/lib64/sevn -lsevn_lib_static
else
BSE_LIBS= -lbse
endif

TARGET: $(BSE_LIB) $(BSE_TEST) petar.get.init.binary

FC=@FC@
CXX=@CXX@

#FFLAGS = -O2 -Wall -finit-real=nan 
CXXFLAGS += @CXXFLAGS@ @OPTFLAGS@ @OPENMP_CXXFLAGS@
FFLAGS += @FCFLAGS@
FCLIBS = @FCLIBS@
#FFLIBS += @FLIBS@
#FFLAGS= -g -O0 -Wall -finit-real=nan -fbounds-check
#CXXFLAGS= -g -O2 -Wall -std=c++11 -fbounds-check

VPATH=$(BSE_PATH)

ifneq ($(se_mode),sevn)
SRC:= $(shell find $(BSE_PATH) -type f  \( -iname '*.f' ! -iname '.*' ! -iname '[sb]se.f' ! -iname 'mo[sb]se.f' ! -iname 'popbin.f' \) )
OBJ:= $(SRC:.f=.o)
endif
ifeq ($(se_mode),bseEmp)
SRC:= $(shell find $(BSE_PATH)  \( -iname '*.f' ! -iname '.*' ! -iname '[sb]se.f' ! -iname 'mo[sb]se.f' ! -iname 'popbin.f' \) )
OBJ:= $(SRC:.f=.o)
SRCCXX:= $(shell find $(BSE_PATH) -maxdepth 1 \( -iname '*.cpp' \) )
OBJCXX:= $(SRCCXX:.cpp=.o)
endif


ifeq ($(se_mode),sevn)
../build/evolve_sevn.o: evolve_sevn.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@ $(BSELIBS)
else
$(BSE_LIB): $(OBJ) $(OBJCXX)
	ar rcs $@ $^
endif

ifeq ($(se_mode),sevn)
$(BSE_TEST): bse_test.cxx $(BSE_LIB) evolvebco_sevn.h bse_interface.h |../build/evolve_sevn.o
	$(CXX) $(CXXFLAGS) $< -o $@ ../build/evolve_sevn.o -L./ $(BSELIBS) $(FCLIBS)
else
$(BSE_TEST): bse_test.cxx $(BSE_LIB) bse_interface.h
	$(CXX) $(CXXFLAGS) $< -o $@ -L./ $(BSELIBS) $(FCLIBS)
endif

petar.get.init.binary: get_init_binary_bse.sh
	ln -sf $< $@

install:
	install -d @prefix@/bin/
	install -m 755 $(BSE_TEST) petar.get.init.binary @prefix@/bin/

clean:
	rm -f $(BSE_PATH)/*.o *.o $(BSE_TEST) $(BSE_LIB)
