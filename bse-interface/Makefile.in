se_mode=@with_interrupt@

ifeq ($(se_mode),bse)
SE_TEST=petar.bse
SE_PATH=bse
CXXFLAGS = -D BSEBBF -D BSE_BASE
else ifeq ($(se_mode),mobse)
SE_TEST=petar.mobse
SE_PATH=mobse
CXXFLAGS = -D MOBSE -D BSE_BASE
else ifeq ($(se_mode),bseEmp)
SE_TEST=petar.bseEmp
SE_PATH=bseEmp
CXXFLAGS = -D BSEEMP -D BSE_BASE
else ifeq ($(se_mode),sevn)
SE_TEST=petar.sevn
SE_PATH=$(SEVN_PREFIX)/include/sevn
CXXFLAGS = -D SEVN -D BSE_BASE
endif

ifeq ($(se_mode),sevn)
SE_LIB=
# @sevn_prefix@/@sevn_lib@ are relative to the PeTar top directory; strip the
# leading ./bse-interface/ so the paths resolve from this subdirectory too
SEVN_PREFIX := $(patsubst ./bse-interface/%,./%,@sevn_prefix@)
SEVN_LIB := $(patsubst ./bse-interface/%,./%,@sevn_lib@)
SELIBS = -I$(SEVN_PREFIX)/include/sevn
else
SE_LIB=libbse.a
SELIBS = -lbse
endif

TARGET: $(SE_LIB) $(SE_TEST) $(SE_TEST).get.init.binary

FC=@FC@
CXX=@CXX@
use_mpi =@use_mpi@
use_omp = @use_omp@

#FFLAGS = -O2 -Wall -finit-real=nan 
CXXFLAGS += @CXXFLAGS@ @OPTFLAGS@
CXXFLAGS += -I@SDAR_PATH@/src
FFLAGS += @FCFLAGS@
FCLIBS = @FCLIBS@

#ifeq ($(use_mpi),yes) 
#CXXFLAGS += -DPARTICLE_SIMULATOR_MPI_PARALLEL
#endif # mpi

ifeq ($(use_omp),yes)
CXXFLAGS += @OPENMP_CXXFLAGS@
FFLAGS += @OPENMP_CXXFLAGS@
CXXFLAGS += -D PARTICLE_SIMULATOR_THREAD_PARALLEL
endif # omp

#FFLIBS += @FLIBS@
#FFLAGS= -g -O0 -Wall -finit-real=nan -fbounds-check
#CXXFLAGS= -g -O2 -Wall -std=c++11 -fbounds-check

VPATH=$(SE_PATH) 

ifneq ($(se_mode),sevn)
SRC:= $(shell find $(SE_PATH) -type f  \( -iname '*.f' ! -iname '.*' ! -iname '[sb]se.f' ! -iname 'mo[sb]se.f' ! -iname 'popbin.f' \) )
OBJ:= $(SRC:.f=.o)
endif
ifeq ($(se_mode),bseEmp)
SRC:= $(shell find $(SE_PATH)  \( -iname '*.f' ! -iname '.*' ! -iname '[sb]se.f' ! -iname 'mo[sb]se.f' ! -iname 'popbin.f' \) )
OBJ:= $(SRC:.f=.o)
SRCCXX:= $(shell find $(SE_PATH) -maxdepth 1 \( -iname '*.cpp' \) )
OBJCXX:= $(SRCCXX:.cpp=.o)
endif

RAND_PATH=../parallel-random
RAND_LIB=$(RAND_PATH)/librand.a
RAND_INCLUDE:= $(shell find $(RAND_PATH) -type f \( -iname '*.hpp' \) )

ifeq ($(se_mode),sevn)
../build/evolve_sevn.o: evolve_sevn.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@ $(SELIBS)
else
$(SE_LIB): $(OBJ) $(OBJCXX) $(RAND_LIB)
	ar rcs $@ $^
endif

ifeq ($(se_mode),sevn)
$(SE_TEST): bse_test.cxx $(SE_LIB) evolvebco_sevn.h bse_interface.h $(RAND_INCLUDE) $(RAND_LIB) |../build/evolve_sevn.o
	$(CXX) $(CXXFLAGS) $< -o $@ ../build/evolve_sevn.o -L../parallel-random $(SELIBS) $(SEVN_LIB) -lrand $(FCLIBS)
else
$(SE_TEST): bse_test.cxx $(SE_LIB) bse_interface.h $(RAND_INCLUDE)
	$(CXX) $(CXXFLAGS) $< -o $@ -L./ -L../parallel-random $(SELIBS) -lrand $(FCLIBS)
endif

../parallel-random/librand.a: ../parallel-random
	$(MAKE) -C ../parallel-random librand.a

$(SE_TEST).get.init.binary: get_init_binary.sh
	ln -sf $< $@

install:
	install -d @prefix@/bin/
	install -m 755 $(SE_TEST) $(SE_TEST).get.init.binary @prefix@/bin/

clean:
	rm -f $(SE_PATH)/*.o *.o $(SE_TEST) $(SE_LIB) $(SE_TEST).get.init.binary
