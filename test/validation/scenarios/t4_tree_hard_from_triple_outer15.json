{
  "name": "t4_tree_hard_from_triple_outer15",
  "description": "Five-mode hierarchical triple comparison control group with original outer semi-major axis a_out=1.5.",
  "workdir": "{repo_root}",
  "setup_commands": [
    "mkdir -p test/validation/work/t4o",
    "python3 test/validation/make_ic.py --case t4_outer15 --output test/validation/work/t4o/input.base",
    "cd test/validation/work/t4o && petar.init -f input input.base"
  ],
  "extract": {
    "period": 0.02962478305322229,
    "n_period": 200,
    "period_metric": "Error/Total",
    "status_n_particle": 3,
    "regex_counts": {
      "runtime_abort": "Segmentation fault|Assertion|Aborted"
    }
  },
  "runs": [
    {
      "id": "m1_pure_sdar_ref_o15",
      "command": "cd test/validation/work/t4o && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 -u 1 -b 1 --tt-switch 0 --r-group 0.18 --r-search-group 0.18 -s 3.0e-5 -r 2 -t 20 -o 0.125 -w 2 -f t4o_m1_pure_sdar_ref input",
      "output": "m1_pure_sdar_ref_o15.log"
    },
    {
      "id": "m2_hard_no_tt_o15",
      "command": "cd test/validation/work/t4o && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 -u 1 -b 1 --tt-switch 0 --r-group 0.01 --r-search-group 0.02 -s 0.03125 -r 2 -t 20 -o 0.125 -w 2 -f t4o_m2_hard_no_tt input",
      "output": "m2_hard_no_tt_o15.log"
    },
    {
      "id": "m3_hard_tt_o15",
      "command": "cd test/validation/work/t4o && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 -u 1 -b 1 --tt-switch 1 --tt-nstep 8 --r-group 0.01 --r-search-group 0.02 -s 0.03125 -r 2 -t 20 -o 0.125 -w 2 -f t4o_m3_hard_tt input",
      "output": "m3_hard_tt_o15.log"
    },
    {
      "id": "m4_tree_no_tt_o15",
      "command": "cd test/validation/work/t4o && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 -u 1 -b 1 --tt-switch 0 --r-group 0.01 --r-search-group 0.02 --r-ratio 0.3 -s 0.03125 -r 0.8 -t 20 -o 0.125 -w 2 -f t4o_m4_tree_no_tt input",
      "output": "m4_tree_no_tt_o15.log"
    },
    {
      "id": "m5_tree_tt_o15",
      "command": "cd test/validation/work/t4o && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 -u 1 -b 1 --tt-switch 1 --tt-nstep 8 --r-group 0.01 --r-search-group 0.02 --r-ratio 0.3 -s 0.03125 -r 0.8 -t 20 -o 0.125 -w 2 -f t4o_m5_tree_tt input",
      "output": "m5_tree_tt_o15.log"
    }
  ],
  "checks": [
    {
      "name": "m3_tidal_tensor_effective",
      "type": "min_threshold",
      "run_id": "m3_hard_tt_o15",
      "metric": "max_artificial_particles_glb",
      "threshold": 1
    },
    {
      "name": "m5_tidal_tensor_effective",
      "type": "min_threshold",
      "run_id": "m5_tree_tt_o15",
      "metric": "max_artificial_particles_glb",
      "threshold": 1
    },
    {
      "name": "m2_no_tidal_tensor_particles",
      "type": "max_threshold",
      "run_id": "m2_hard_no_tt_o15",
      "metric": "max_artificial_particles_glb",
      "threshold": 0
    },
    {
      "name": "m4_no_tidal_tensor_particles",
      "type": "max_threshold",
      "run_id": "m4_tree_no_tt_o15",
      "metric": "max_artificial_particles_glb",
      "threshold": 0
    },
    {
      "name": "m1_no_runtime_abort",
      "type": "regex_count_max",
      "run_id": "m1_pure_sdar_ref_o15",
      "regex_key": "runtime_abort",
      "threshold": 0
    },
    {
      "name": "m2_no_runtime_abort",
      "type": "regex_count_max",
      "run_id": "m2_hard_no_tt_o15",
      "regex_key": "runtime_abort",
      "threshold": 0
    },
    {
      "name": "m3_no_runtime_abort",
      "type": "regex_count_max",
      "run_id": "m3_hard_tt_o15",
      "regex_key": "runtime_abort",
      "threshold": 0
    },
    {
      "name": "m4_no_runtime_abort",
      "type": "regex_count_max",
      "run_id": "m4_tree_no_tt_o15",
      "regex_key": "runtime_abort",
      "threshold": 0
    },
    {
      "name": "m5_no_runtime_abort",
      "type": "regex_count_max",
      "run_id": "m5_tree_tt_o15",
      "regex_key": "runtime_abort",
      "threshold": 0
    }
  ]
}
