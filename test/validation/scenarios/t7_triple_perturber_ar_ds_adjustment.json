{
  "name": "t7_triple_perturber_ar_ds_adjustment",
  "description": "AR sd-reference work-credit corruption: an ultra-tight hierarchical trio plus one static perturber inside the intruder's changeover transition band drives a continuous per-step energy flow into the internal-only H audit. Root cause (SDAR 2026-10-21, commit 6a8a357): the SD reference etot_sd_ref_ absorbed full-weight perturbation work while the slowed system takes the kappa-weighted part, so R = S - etot_sd_ref_ drifted at -(1-1/kappa)*W and the controller collapsed ds by ~5 orders (10^6-substep caps; the interim 2026-10-19 rate-type EMA separation was removed). The fix credits work at the slowdown system's own velocity-gradient (vel_sd) rate, removes the n>=3 fix_step_option=later auto-grant, and adds physically-gated sd-gauge repairs. Seven runs: r1 rp=0.15 and r3 rp=0.30 inside the intruder band [0.082, 0.545] (trigger guards: step budget + no warnings/aborts), r2 rp=0.05 deep inside r_in (k = 1, false-positive guard), r4 rp=0.15 with the BTLogH g-function (--ar-g-func 1, gauge comparison), r5 rp=0.60 outside r_out, and r6/r7 rp=0.35/0.50 across the former ds-floor-abort band (later-freeze + degenerate-gauge zone pre-fix; abort-to-complete guards). No stellar evolution and no external potential are involved.",
  "cores": 3,
  "parallel_runs": true,
  "workdir": "{repo_root}",
  "setup_commands": [
    "rm -rf test/validation/work/t7 && mkdir -p test/validation/work/t7",
    "python3 test/validation/make_ic.py --case t7 --output test/validation/work/t7/input.band",
    "python3 test/validation/make_ic.py --case t7_band2 --output test/validation/work/t7/input.band2",
    "python3 test/validation/make_ic.py --case t7_control_in --output test/validation/work/t7/input.inside",
    "python3 test/validation/make_ic.py --case t7_outer --output test/validation/work/t7/input.outer",
    "python3 test/validation/make_ic.py --case t7_abortzone --output test/validation/work/t7/input.abortzone",
    "python3 test/validation/make_ic.py --case t7_abortzone2 --output test/validation/work/t7/input.abortzone2",
    "cd test/validation/work/t7 && petar.init -f input_band input.band && petar.init -f input_band2 input.band2 && petar.init -f input_inside input.inside && petar.init -f input_outer input.outer && petar.init -f input_abortzone input.abortzone && petar.init -f input_abortzone2 input.abortzone2"
  ],
  "extract": {
    "regex_counts": {
      "step_warning": "step count is signficiant",
      "ds_floor_abort": "below time resolution",
      "runtime_abort": "Segmentation fault|Assertion|Aborted",
      "large_energy": "Large_energy_error"
    },
    "regex_floats": {
      "ar_step_sum": "AR_step_sum[ \\t]*\\n[ \\t0-9.e+-]*?[ \\t]([0-9.eE+-]+)\\s*\\n"
    }
  },
  "runs": [
    {
      "id": "r1_pert_band_mid",
      "command": "cd test/validation/work/t7 && OMP_NUM_THREADS=1 {petar_bin_switch} -u 0 -t 0.0078 -o 0.0078 -b 4 -s 0.0156 --r 0.6 --r-ratio 0.15 --r-search-group 0.05 --G 0.00449830997959438 -f t7_r1_band input_band",
      "output": "r1_pert_band_mid.log"
    },
    {
      "id": "r2_pert_inside_rin",
      "command": "cd test/validation/work/t7 && OMP_NUM_THREADS=1 {petar_bin_switch} -u 0 -t 0.0078 -o 0.0078 -b 4 -s 0.0156 --r 0.6 --r-ratio 0.15 --r-search-group 0.05 --G 0.00449830997959438 -f t7_r2_inside input_inside",
      "output": "r2_pert_inside_rin.log"
    },
    {
      "id": "r3_pert_band_far",
      "command": "cd test/validation/work/t7 && OMP_NUM_THREADS=1 {petar_bin_switch} -u 0 -t 0.0078 -o 0.0078 -b 4 -s 0.0156 --r 0.6 --r-ratio 0.15 --r-search-group 0.05 --G 0.00449830997959438 -f t7_r3_band2 input_band2",
      "output": "r3_pert_band_far.log"
    },
    {
      "id": "r4_pert_band_mid_btlogh",
      "command": "cd test/validation/work/t7 && OMP_NUM_THREADS=1 {petar_bin_switch} -u 0 -t 0.0078 -o 0.0078 -b 4 -s 0.0156 --r 0.6 --r-ratio 0.15 --r-search-group 0.05 --G 0.00449830997959438 --ar-g-func 1 -f t7_r4_btlogh input_band",
      "output": "r4_pert_band_mid_btlogh.log"
    },
    {
      "id": "r5_pert_outer",
      "command": "cd test/validation/work/t7 && OMP_NUM_THREADS=1 {petar_bin_switch} -u 0 -t 0.0078 -o 0.0078 -b 4 -s 0.0156 --r 0.6 --r-ratio 0.15 --r-search-group 0.05 --G 0.00449830997959438 -f t7_r5_outer input_outer",
      "output": "r5_pert_outer.log"
    },
    {
      "id": "r6_pert_abort_band_near",
      "command": "cd test/validation/work/t7 && OMP_NUM_THREADS=1 {petar_bin_switch} -u 0 -t 0.0078 -o 0.0078 -b 4 -s 0.0156 --r 0.6 --r-ratio 0.15 --r-search-group 0.05 --G 0.00449830997959438 -f t7_r6_abortzone input_abortzone",
      "output": "r6_pert_abort_band_near.log"
    },
    {
      "id": "r7_pert_abort_band_far",
      "command": "cd test/validation/work/t7 && OMP_NUM_THREADS=1 {petar_bin_switch} -u 0 -t 0.0078 -o 0.0078 -b 4 -s 0.0156 --r 0.6 --r-ratio 0.15 --r-search-group 0.05 --G 0.00449830997959438 -f t7_r7_abortzone2 input_abortzone2",
      "output": "r7_pert_abort_band_far.log"
    }
  ],
  "checks": [
    {
      "name": "r1_band_mid_ar_step_budget",
      "type": "max_threshold",
      "run_id": "r1_pert_band_mid",
      "metric": "ar_step_sum",
      "threshold": 1000000
    },
    {
      "name": "r1_band_mid_no_step_warning",
      "type": "regex_count_max",
      "run_id": "r1_pert_band_mid",
      "regex_key": "step_warning",
      "threshold": 0
    },
    {
      "name": "r1_band_mid_no_ds_floor_abort",
      "type": "regex_count_max",
      "run_id": "r1_pert_band_mid",
      "regex_key": "ds_floor_abort",
      "threshold": 0
    },
    {
      "name": "r1_band_mid_energy_guard",
      "type": "max_threshold",
      "run_id": "r1_pert_band_mid",
      "metric": "max_abs_error_over_total",
      "threshold": 0.5
    },
    {
