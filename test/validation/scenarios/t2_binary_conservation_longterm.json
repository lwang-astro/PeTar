{
  "name": "t2_binary_conservation_longterm",
  "description": "Long-term (>=100 periods) energy-error behaviour of a pure binary under AUTO changeover radii (no -r): the radii track dt_soft, so the sweep naturally covers pure-tree (dt17: r_out < r_peri), mix (dt12-dt9: changeover active inside the orbit) and pure-Hermite (dt8: r_in > r_apo). Purposes: (1) no secular energy-error drift in any regime; (2) the auto-derived changeover keeps the error level approximately consistent across dt_soft (no dt^4 fixed-radii scaling).",
  "workdir": "{repo_root}",
  "setup_commands": [
    "mkdir -p test/out/work/t2",
    "python3 test/validation/make_ic.py --case t2 --output test/out/work/t2/input.base",
    "cd test/out/work/t2 && petar.init -f input input.base"
  ],
  "extract": {
    "period": 0.028256534656,
    "n_period": 100,
    "period_metric": "Error/Total",
    "regex_counts": {
      "hard_energy_significant": "Hard energy significant",
      "large_step_warning": "Large step",
      "hard_dump": "hard_large_energy\\."
    }
  },
  "runs": [
    {
      "id": "dt12",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 2.44140625e-4 -o 4.8828125e-4 -w 2 -f t2_dt12 input",
      "output": "dt12.log"
    },
    {
      "id": "dt11",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 4.8828125e-4 -o 9.765625e-4 -w 2 -f t2_dt11 input",
      "output": "dt11.log"
    },
    {
      "id": "dt10",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 9.765625e-4 -o 1.953125e-3 -w 2 -f t2_dt10 input",
      "output": "dt10.log"
    },
    {
      "id": "dt9",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 1.953125e-3 -o 3.90625e-3 -w 2 -f t2_dt9 input",
      "output": "dt9.log"
    },
    {
      "id": "dt8",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 3.90625e-3 -o 7.8125e-3 -w 2 -f t2_dt8 input",
      "output": "dt8.log"
    },
    {
      "id": "dt17",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-6 --r-search-group 1e-5 -u 1 -b 1 -t 3.2 -s 7.62939453125e-6 -o 9.765625e-4 -w 2 -f t2_dt17 input",
      "output": "dt17.log"
    },
    {
      "id": "dt13",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-6 --r-search-group 1e-5 -u 1 -b 1 -t 3.2 -s 1.220703125e-4 -o 2.44140625e-4 -w 2 -f t2_dt13 input",
      "output": "dt13.log"
    },
    {
      "id": "dt14",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-6 --r-search-group 1e-5 -u 1 -b 1 -t 3.2 -s 6.103515625e-5 -o 4.8828125e-4 -w 2 -f t2_dt14 input",
      "output": "dt14.log"
    },
    {
      "id": "dt15",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-6 --r-search-group 1e-5 -u 1 -b 1 -t 3.2 -s 3.0517578125e-5 -o 9.765625e-4 -w 2 -f t2_dt15 input",
      "output": "dt15.log"
    },
    {
      "id": "dt16",
      "command": "cd test/out/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-6 --r-search-group 1e-5 -u 1 -b 1 -t 3.2 -s 1.52587890625e-5 -o 9.765625e-4 -w 2 -f t2_dt16 input",
      "output": "dt16.log"
    }
  ],
  "checks": [
    {
      "name": "energy_error_stationary_dt17",
      "type": "max_threshold",
      "run_id": "dt17",
      "metric": "late_early_period_max_ratio",
      "threshold": 2.0,
      "comment": "Purpose 1 (pure tree): max per-period error in the second half of the run <= 2x the first half, i.e. no secular energy-error drift over ~113 periods"
    },
    {
      "name": "energy_error_stationary_dt12",
      "type": "max_threshold",
      "run_id": "dt12",
      "metric": "late_early_period_max_ratio",
      "threshold": 2.0,
      "comment": "Purpose 1 (mix): stationarity of the per-period error envelope under the active changeover"
    },
    {
      "name": "energy_error_stationary_dt8",
      "type": "max_threshold",
      "run_id": "dt8",
      "metric": "late_early_period_max_ratio",
      "threshold": 2.0,
      "comment": "Purpose 1 (pure Hermite): stationarity when the whole orbit sits inside the auto r_in"
    },
    {
      "name": "energy_level_consistent_across_dt",
      "type": "metric_ratio",
      "numerator_run_id": "dt17",
      "denominator_run_id": "dt12",
      "metric": "max_abs_error_over_total",
      "min_ratio": 1.0,
      "max_ratio": 300.0,
      "comment": "Purpose 2: across the full contiguous sweep (512x in dt_soft, 2^-17..2^-8, spanning pure tree / mix / pure Hermite) the auto-changeover level stays within ~2 orders of magnitude (measured ~100x); fixed radii would give dt^4 ~ 1e11"
    }
  ]
}