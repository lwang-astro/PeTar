{
  "name": "t2_binary_conservation_longterm",
  "description": "Long-term binary conservation test (>=100 periods): dt_soft sweep with auto changeover radii, focusing on semi/ecc conservation without assuming dt_soft scaling.",
  "workdir": "{repo_root}",
  "setup_commands": [
    "mkdir -p test/validation/work/t2",
    "python3 test/validation/make_ic.py --case t2 --output test/validation/work/t2/input.base",
    "cd test/validation/work/t2 && petar.init -f input input.base"
  ],
  "extract": {
    "period": 0.028256534656,
    "n_period": 100,
    "period_metric": "Error/Total",
    "regex_counts": {
      "hard_energy_significant": "Hard energy significant",
      "large_step_warning": "Large step",
      "hard_dump": "hard_large_energy\\."
    }
  },
  "runs": [
    {
      "id": "dt12",
      "command": "cd test/validation/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 2.44140625e-4 -o 4.8828125e-4 -w 2 -f t2_dt12 input",
      "output": "dt12.log"
    },
    {
      "id": "dt11",
      "command": "cd test/validation/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 4.8828125e-4 -o 9.765625e-4 -w 2 -f t2_dt11 input",
      "output": "dt11.log"
    },
    {
      "id": "dt10",
      "command": "cd test/validation/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 9.765625e-4 -o 1.953125e-3 -w 2 -f t2_dt10 input",
      "output": "dt10.log"
    },
    {
      "id": "dt9",
      "command": "cd test/validation/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 1.953125e-3 -o 3.90625e-3 -w 2 -f t2_dt9 input",
      "output": "dt9.log"
    },
    {
      "id": "dt8",
      "command": "cd test/validation/work/t2 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1e-3 -u 1 -b 1 -t 3.2 -s 3.90625e-3 -o 7.8125e-3 -w 2 -f t2_dt8 input",
      "output": "dt8.log"
    }
  ],
  "checks": [
    {
      "name": "sum_period_max_error_monotonic_vs_dt",
      "type": "monotonic_trend",
      "run_ids": [
        "dt12",
        "dt11",
        "dt10",
        "dt9",
        "dt8"
      ],
      "metric": "sum_abs_error_period_max",
      "direction": "nondecreasing",
      "relative_tolerance": 0.05
    },
    {
      "name": "dt_times_period_max_error_monotonic_vs_dt",
      "type": "monotonic_trend",
      "run_ids": [
        "dt12",
        "dt11",
        "dt10",
        "dt9",
        "dt8"
      ],
      "metric": "dt_soft_times_max_abs_error_period_max",
      "direction": "nondecreasing",
      "relative_tolerance": 0.05
    },
    {
      "name": "dt12_no_large_step_warning",
      "type": "regex_count_max",
      "run_id": "dt12",
      "regex_key": "large_step_warning",
      "threshold": 0
    },
    {
      "name": "dt8_no_large_step_warning",
      "type": "regex_count_max",
      "run_id": "dt8",
      "regex_key": "large_step_warning",
      "threshold": 0
    }
  ]
}