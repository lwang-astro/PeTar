{
  "name": "t4_tree_hard_from_triple",
  "description": "Particle-tree + hard validation from hierarchical triple embedded in a low-mass background system.",
  "workdir": "{repo_root}",
  "setup_commands": [
    "mkdir -p test/validation/work/t4",
    "python3 test/validation/make_ic.py --case t4 --output test/validation/work/t4/input.base",
    "cd test/validation/work/t4 && petar.init -f input input.base"
  ],
  "extract": {
    "regex_counts": {
      "hard_energy_significant": "Hard energy significant",
      "large_step_warning": "Large step",
      "hard_dump": "hard_large_energy\\."
    }
  },
  "runs": [
    {
      "id": "baseline",
      "command": "cd test/validation/work/t4 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 6e-4 --r-search-group 1.2e-3 -u 1 -b 1 -t 0.08 -s 1.5e-4 -r 0.08 -o 1e-3 -w 2 -f t4_baseline input",
      "output": "baseline.log"
    },
    {
      "id": "stress",
      "command": "cd test/validation/work/t4 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 2e-4 --r-search-group 5e-4 -u 1 -b 1 -t 0.08 -s 3.0e-4 -r 0.06 -o 1e-3 -w 2 -f t4_stress input",
      "output": "stress.log"
    }
  ],
  "checks": [
    {
      "name": "baseline_energy_bound",
      "type": "max_threshold",
      "run_id": "baseline",
      "metric": "max_abs_error_over_total",
      "threshold": 5e-6
    },
    {
      "name": "stress_hard_pp_bound",
      "type": "max_threshold",
      "run_id": "stress",
      "metric": "max_abs_error_pp",
      "threshold": 2e-5
    },
    {
      "name": "baseline_no_hard_dump",
      "type": "regex_count_max",
      "run_id": "baseline",
      "regex_key": "hard_dump",
      "threshold": 0
    },
    {
      "name": "stress_no_large_step_warning",
      "type": "regex_count_max",
      "run_id": "stress",
      "regex_key": "large_step_warning",
      "threshold": 0
    }
  ]
}