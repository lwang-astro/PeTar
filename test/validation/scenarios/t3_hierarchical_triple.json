{
  "name": "t3_hierarchical_triple",
  "description": "Hierarchical triple test for Hermite+SDAR behavior; includes stable and stress parameter sets.",
  "workdir": "{repo_root}",
  "setup_commands": [
    "mkdir -p test/validation/work/t3",
    "python3 test/validation/make_ic.py --case t3 --output test/validation/work/t3/input.base",
    "cd test/validation/work/t3 && petar.init -f input input.base"
  ],
  "extract": {
    "regex_counts": {
      "hard_energy_significant": "Hard energy significant",
      "large_step_warning": "Large step",
      "hard_dump": "hard_large_energy\\."
    }
  },
  "runs": [
    {
      "id": "stable",
      "command": "cd test/validation/work/t3 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 5e-4 --r-search-group 1.0e-3 -u 1 -b 1 -t 0.12 -s 1e-4 -r 0.05 -o 1e-3 -w 2 -f t3_stable input",
      "output": "stable.log"
    },
    {
      "id": "stress",
      "command": "cd test/validation/work/t3 && OMP_NUM_THREADS=1 {petar_bin_switch} -a 0 --r-group 2e-4 --r-search-group 4.0e-4 -u 1 -b 1 -t 0.12 -s 2e-4 -r 0.04 -o 1e-3 -w 2 -f t3_stress input",
      "output": "stress.log"
    }
  ],
  "checks": [
    {
      "name": "stable_energy_bound",
      "type": "max_threshold",
      "run_id": "stable",
      "metric": "max_abs_error_over_total",
      "threshold": 2e-6
    },
    {
      "name": "stress_energy_bound",
      "type": "max_threshold",
      "run_id": "stress",
      "metric": "max_abs_error_over_total",
      "threshold": 2e-5
    },
    {
      "name": "stable_no_large_step_warning",
      "type": "regex_count_max",
      "run_id": "stable",
      "regex_key": "large_step_warning",
      "threshold": 0
    },
    {
      "name": "stress_no_hard_dump",
      "type": "regex_count_max",
      "run_id": "stress",
      "regex_key": "hard_dump",
      "threshold": 0
    }
  ]
}