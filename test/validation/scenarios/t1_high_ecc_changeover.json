{
  "name": "t1_high_ecc_changeover",
  "description": "Kepler-orbit changeover validation using semi=0.1 pc, e=0.9, m1=1, m2=10, dt=2^[-13,-6]. Three families: the full-crossing core target (peri < r_in < r_out < apo, r_out=0.15) validated against the pure particle-tree reference (r_peri > r_out, r_out=0.005; KDKDK4 4th order above the build-dependent round-off floor) and the pure-Hermite reference (r_apo < r_in, r_out=2.0; 4th order below the block-step dt threshold, weak-dt plateau above it).",
  "workdir": "{repo_root}",
  "setup_commands": [
    "mkdir -p test/out/work/t1",
    "python3 test/validation/make_ic.py --case t1 --output test/out/work/t1/input.base",
    "cd test/out/work/t1 && petar.init -f input input.base",
    "cd test/out/work/t1 && printf '2\n' > input.h4 && awk '{print $0,0.0}' input.base >> input.h4 && printf '0\n' >> input.h4"
  ],
  "extract": {
    "regex_counts": {
      "hard_energy_significant": "Hard energy significant",
      "large_step_warning": "Large step"
    }
  },
  "runs": [
    {
      "id": "inside_r0005_si00",
      "command": "cd test/out/work/t1 && OMP_NUM_THREADS=1 {petar_bin_order4} -a 0 --r-group 1e-6 --r-search-group 1e-6 -u 1 -t 0.8932208171201599 -s 1.220703125e-4 -r 0.005 -o 1.220703125e-4 -w 2 -f inside_r0005_si00 input",
      "output": "inside_r0005_si00.log"
    },
    {
      "id": "inside_r0005_si01",
      "command": "cd test/out/work/t1 && OMP_NUM_THREADS=1 {petar_bin_order4} -a 0 --r-group 1e-6 --r-search-group 1e-6 -u 1 -t 0.8932208171201599 -s 2.44140625e-4 -r 0.005 -o 2.44140625e-4 -w 2 -f inside_r0005_si01 input",
