  "checks": [
    {
      "name": "pure_tree_order_64b",
      "type": "loglog_slope",
      "run_ids": [
        "inside_r0005_si00",
        "inside_r0005_si01",
        "inside_r0005_si02",
        "inside_r0005_si03",
        "inside_r0005_si04",
        "inside_r0005_si05",
        "inside_r0005_si06"
      ],
      "metric": "max_abs_error_over_total",
      "x_metric": "dt_soft",
      "expected_slope": 3.5,
      "slope_tolerance": 0.0,
      "bound": "min",
      "require_var_contains": [
        "petar_bin_order4",
        ".64b"
      ],
      "comment": "T1-a: KDKDK4 4th order above the 64b round-off floor, dt 1.22e-4 - 7.81e-3"
    },
    {
      "name": "pure_tree_order_non64b",
      "type": "loglog_slope",
      "run_ids": [
        "inside_r0005_si03",
        "inside_r0005_si04",
        "inside_r0005_si05",
        "inside_r0005_si06"
      ],
      "metric": "max_abs_error_over_total",
      "x_metric": "dt_soft",
      "expected_slope": 3.5,
      "slope_tolerance": 0.0,
      "bound": "min",
      "require_var_not_contains": [
        "petar_bin_order4",
        ".64b"
      ],
      "comment": "T1-a: same order above the higher non64b round-off floor, dt 9.77e-4 - 7.81e-3"
    },
    {
      "name": "pure_hermite_order",
      "type": "loglog_slope",
      "run_ids": [
        "hard_r200_si01",
        "hard_r200_si02"
      ],
      "metric": "max_abs_error_over_total",
      "x_metric": "dt_soft",
      "expected_slope": 3.5,
      "slope_tolerance": 0.0,
      "bound": "min",
      "comment": "T1-b: 4th order below the block-step dt threshold, dt 2.44e-4 - 4.88e-4"
    },
    {
      "name": "pure_hermite_weak_dt_dependence",
      "type": "loglog_slope",
      "run_ids": [
        "hard_r200_si03",
        "hard_r200_si04",
        "hard_r200_si05",
        "hard_r200_si06",
        "hard_r200_si07"
      ],
      "metric": "max_abs_error_over_total",
      "x_metric": "dt_soft",
      "expected_slope": 1.0,
      "slope_tolerance": 0.0,
      "bound": "max",
      "comment": "T1-b: block steps self-regulate, weak dt dependence for dt > 4.88e-4"
    },
    {
      "name": "mix_follows_hermite_fine",
      "type": "metric_ratio",
      "numerator_run_id": "crossfull_r015_si00",
      "denominator_run_id": "hard_r200_si00",
      "metric": "max_abs_error_over_total",
      "min_ratio": 0.5,
      "max_ratio": 2.0,
      "require_var_contains": [
        "petar_bin_order4",
        ".64b"
      ],
      "comment": "T1-b/c: inside r_in the crossing run follows pure Hermite (64b; the non64b annulus round-off floor sits above the Hermite level by construction)"
    },
    {
      "name": "mix_tree_regime_order",
      "type": "loglog_slope",
      "run_ids": [
        "crossfull_r015_si06",
        "crossfull_r015_si07"
      ],
      "metric": "max_abs_error_over_total",
      "x_metric": "dt_soft",
      "expected_slope": 3.5,
      "slope_tolerance": 0.0,
      "bound": "min",
      "comment": "T1-c: otherwise (tree/annulus-dominated coarse end) the error grows at least at 4th order"
    },
    {
      "name": "mix_error_below_pure_tree_fine",
      "type": "metric_ratio",
      "numerator_run_id": "crossfull_r015_si00",
      "denominator_run_id": "inside_r0005_si00",
      "metric": "max_abs_error_over_total",
      "min_ratio": 0.0,
      "max_ratio": 1.0,
      "comment": "T1-c: crossing error between the references (upper bound vs pure tree at fine dt; the Hermite lower bound is enforced by mix_follows_hermite_fine for 64b and holds trivially for non64b)"
    }
  ]
