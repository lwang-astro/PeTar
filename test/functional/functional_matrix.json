{
  "build": {
    "script": "install_petar_major_versions.sh",
    "strict_env": {
      "STRICT_BUILD": "1"
    }
  },
  "global": {
    "optional_select": "mpi,omp,avx512,avx2",
    "filename_prefix": "data",
    "run_env": {
      "OMP_NUM_THREADS": "1",
      "OMP_STACKSIZE": "128M"
    },
    "t_end": 10,
    "dt_out": 1,
    "ic_case": "functional_mcluster_smoke",
    "step_timeout_s": 1800
  },
  "cases": [
    {
      "name": "std",
      "require": "",
      "interrupt_mode": "none",
      "init_args": [
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "10",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-G",
        "0.00449830997959438"
      ],
      "object_snap_args": [],
      "tool_smokes": [
        "find.dt",
        "data.gether",
        "format.transfer"
      ]
    },
    {
      "name": "merger",
      "require": "merger",
      "interrupt_mode": "merger",
      "init_args": [
        "-s",
        "merger",
        "--radius",
        "4.5092203040509496e-08",
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "1",
        "--detect-interrupt",
        "1",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-i",
        "merger",
        "-G",
        "0.00449830997959438"
      ],
      "object_snap_args": [
        "-i",
        "merger"
      ],
      "ic_case": "functional_mcluster_pair_smoke"
    },
    {
      "name": "dsm",
      "require": "dsm",
      "interrupt_mode": "dsm",
      "init_args": [
        "-s",
        "dsm",
        "--type",
        "2",
        "--radius",
        "4.5092203040509496e-08",
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "1",
        "--detect-interrupt",
        "1",
        "--dsm-new-star-mode",
        "0",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-i",
        "dsm",
        "-G",
        "0.00449830997959438"
      ],
      "object_snap_args": [
        "-i",
        "dsm"
      ],
      "ic_case": "functional_mcluster_pair_smoke"
    },
    {
      "name": "bse",
      "require": "bse",
      "interrupt_mode": "bse",
      "init_args": [
        "-s",
        "bse",
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "4",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-i",
        "bse"
      ],
      "object_snap_args": [
        "-i",
        "bse"
      ],
      "ic_case": "functional_mcluster_dual_merge_smoke",
      "tool_smokes": [
        "bse"
      ]
    },
    {
      "name": "gasdrag",
      "require": "gasdrag",
      "interrupt_mode": "none",
      "init_args": [
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "10",
        "--gdf-hard-mode",
        "1",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-G",
        "0.00449830997959438"
      ],
      "object_snap_args": [],
      "expect_files": [
        "{prefix}.par.gasdrag",
        "{prefix}.par.exthard"
      ]
    },
    {
      "name": "std-restart",
      "require": "",
      "interrupt_mode": "none",
      "restart_t_end": 4,
      "init_args": [
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "10",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-G",
        "0.00449830997959438"
      ],
      "object_snap_args": [],
      "tool_smokes": [
        "read.par",
        "update.par",
        "data.clear"
      ]
    },
    {
      "name": "sevn",
      "require": "sevn",
      "interrupt_mode": "sevn",
      "optional": true,
      "ic_case": "functional_sevn_cluster",
      "init_args": [
        "-s",
        "sevn",
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "0",
        "-z",
        "0.00142857",
        "--tables",
        "{SEVN_TABLES}",
        "--tabuse_rhe",
        "false",
        "--tabuse_rco",
        "false",
        "--tabuse_envconv",
        "false",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-i",
        "sevn"
      ],
      "object_snap_args": [
        "-i",
        "sevn"
      ]
    },
    {
      "name": "galpy",
      "require": "galpy",
      "interrupt_mode": "none",
      "init_args": [
        "-t",
        "-c",
        "8000,0,0,0,220,0",
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "10",
        "--galpy-set",
        "MWPotential2014",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-t",
        "galpy",
        "--r-escape",
        "tidal",
        "-G",
        "0.00449830997959438"
      ],
      "object_snap_args": [
        "-t",
        "galpy"
      ]
    },
    {
      "name": "bse-galpy",
      "require": "bse,galpy",
      "filename_prefix": "out",
      "interrupt_mode": "bse",
      "init_args": [
        "-s",
        "bse",
        "-t",
        "-c",
        "8000,0,0,0,220,0",
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "4",
        "--galpy-set",
        "MWPotential2014",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-i",
        "bse",
        "-t",
        "galpy",
        "--r-escape",
        "tidal"
      ],
      "object_snap_args": [
        "-i",
        "bse",
        "-t",
        "galpy"
      ],
      "ic_case": "functional_mcluster_dual_merge_smoke"
    },
    {
      "name": "bse-agama",
      "require": "bse,agama",
      "interrupt_mode": "bse",
      "optional": true,
      "skip_if_unresolved": [
        "AGAMA_CONF_FILE"
      ],
      "init_args": [
        "-s",
        "bse",
        "-t",
        "-c",
        "8000,0,0,0,-180,0",
        "-v",
        "1.022712165045695"
      ],
      "run_args": [
        "-b",
        "4",
        "--agama-conf-file",
        "{AGAMA_CONF_FILE}",
        "--write-group-info",
        "2"
      ],
      "process_args": [
        "-i",
        "bse",
        "-t",
        "agama",
        "--r-escape",
        "tidal"
      ],
      "object_snap_args": [
        "-i",
        "bse",
        "-t",
        "agama"
      ],
      "ic_case": "functional_mcluster_dual_merge_smoke"
    }
  ]
}
